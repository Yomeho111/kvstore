# syntax=docker/dockerfile:1
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
ARG UV_IMAGE=ghcr.io/astral-sh/uv:latest

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS builder
RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential \
        ca-certificates \
        cargo \
        cmake \
        git \
        libffi-dev \
        libssl-dev \
        ninja-build \
        pkg-config \
        rustc \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /build/vectordb_service
COPY vectordb_service/pyproject.toml vectordb_service/uv.lock vectordb_service/README.md ./
COPY vectordb_service/.gitignore ./
COPY vectordb_service/src/ ./src/
COPY vectordb_service/proto/ ./proto/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --extra embedding --no-editable --python /usr/local/bin/python

FROM ${PYTHON_IMAGE} AS runtime
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home app \
    && mkdir -p /app /cache/huggingface /etc/vectordb \
    && chown -R app:app /app /cache

COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    VIRTUAL_ENV=/opt/venv \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/cache/huggingface \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=2 \
    MKL_NUM_THREADS=2
WORKDIR /app
USER 10001:10001
EXPOSE 50051
STOPSIGNAL SIGTERM
ENTRYPOINT ["/opt/venv/bin/vectordb-server"]
CMD ["--listen", "0.0.0.0:50051", "--server-config", "/etc/vectordb/server_config.json", "--model", "Alibaba-NLP/gte-multilingual-base"]